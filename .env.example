# Copy this file to .env and fill in your own key to run in "live" mode.
# Without this, the agent runs in "mock" mode automatically - fully
# offline, no API key needed, rule-based instead of LLM-powered.

# Free tier, no credit card required: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides - sensible defaults are already set in src/config.py.
# Check https://console.groq.com/docs/models for Groq's current model lineup
# if these ever stop working (model names on Groq's free tier do change).
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Screening round sizes
# INITIAL_POOL_SIZE=100
# ROUND1_SHORTLIST_SIZE=10
